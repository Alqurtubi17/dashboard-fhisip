generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(cuid())
  name              String
  email             String                 @unique
  password          String
  roleId            String
  role              Role                   @relation(fields: [roleId], references: [id])
  prodiCode         String?                // Opsional: Asosiasi prodi (misal untuk Kaprodi)
  status            Status                 @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  auditLogs         AuditLog[]
  pengajuanDibuat   PengajuanPengguguran[] @relation("PengajuUser")
  verifikasiProdi   PengajuanPengguguran[] @relation("VerifikatorProdi")
  keputusanAkademik PengajuanPengguguran[] @relation("KeputusanAkademik")

  @@map("users")
}

enum Status {
  ACTIVE
  INACTIVE
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  menus       RoleMenu[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  module    String
  action    String
  label     String?
  roles     RolePermission[]
  createdAt DateTime         @default(now())

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Menu {
  id            String     @id @default(cuid())
  name          String
  icon          String?
  url           String?
  parentId      String?
  parent        Menu?      @relation("MenuToMenu", fields: [parentId], references: [id], onDelete: Cascade)
  children      Menu[]     @relation("MenuToMenu")
  sort          Int        @default(0)
  permissionKey String?
  roles         RoleMenu[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("menus")
}

model RoleMenu {
  roleId String
  menuId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ip        String?
  device    String?
  browser   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model ExternalAuthProvider {
  id               String      @id @default(cuid())
  name             String
  loginUrl         String
  authPayloadJson  String      @db.Text
  tokenResponseKey String      @default("access_token")
  contentType      String      @default("application/json")
  graphqlQuery     String?     @db.Text
  headerName       String      @default("Authorization")
  headerPrefix     String      @default("Bearer ")
  cachedToken      String?     @db.Text
  tokenExpiresAt   DateTime?
  status           Status      @default(ACTIVE)
  apiConfigs       ApiConfig[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("external_auth_providers")
}

model ApiConfig {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  targetUrl    String
  method       String                @default("POST")
  graphqlQuery String?               @db.Text
  providerId   String?
  provider     ExternalAuthProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  status       Status                @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("api_configs")
}

model PrediksiKelas {
  id                String   @id @default(cuid())
  masa              String   // contoh: '20261', '20262'
  kodeMatkul        String
  namaMatkul        String
  sks               Int      @default(3)
  prodiCode         String   // HKUM, IKOM, ADPU, ADBI, IPEM, SOSI, SING, PUS, PAJAK
  prodiName         String
  sipasNonTtm       Int      @default(0)
  nonSipas          Int      @default(0)
  ttmSipas          Int      @default(0)
  tutonSipas        Int      @default(0)
  jumlahTTM         Int      @default(0)
  jumlahTuton       Int      @default(0)
  totalMahasiswa    Int      @default(0)
  kebutuhanKelas    Int      @default(0)
  kebutuhanTutorMin Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([masa, kodeMatkul])
  @@map("prediksi_kelas")
}

model Mahasiswa {
  nim                  String                 @id
  name                 String
  prodi                String
  prodiCode            String?
  semester             Int                    @default(1)
  status               String                 @default("Aktif")
  ipk                  String                 @default("0.00")
  phone                String?
  email                String?
  password             String?                // Hashed password bcryptjs
  kurikulum            String?                @default("2024")
  lastLoginAt          DateTime?
  syncedAt             DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  pengajuanPengguguran PengajuanPengguguran[]

  @@index([prodi])
  @@index([status])
  @@index([semester])
  @@index([name])
  @@map("mahasiswa")
}

enum MataKuliahKategori {
  INTI
  NON_INTI
}

enum StatusPengguguran {
  MENUNGGU_VERIFIKASI_PRODI
  DITOLAK_PRODI
  DISETUJUI_PRODI
  DITOLAK_AKADEMIK
  DISETUJUI_AKADEMIK
}

model MataKuliah {
  id          String             @id @default(cuid())
  kodeMatkul  String             @unique
  namaMatkul  String
  sks         Int                @default(3)
  prodiCode   String
  prodiName   String
  kategori    MataKuliahKategori @default(NON_INTI)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  pengajuan   PengajuanPengguguran[]

  @@index([prodiCode])
  @@index([kategori])
  @@map("mata_kuliah")
}

model PeriodePengguguran {
  id                      String                 @id @default(cuid())
  tahunAkademik           String                 // Contoh: "2026/2027 Ganjil"
  semester                String                 // Contoh: "20261"
  nama                    String                 // Contoh: "Periode Pengguguran Semester 2026.1"
  isActive                Boolean                @default(true)
  
  // Timeline Stages (WIB)
  pengajuanStart          DateTime
  pengajuanEnd            DateTime
  
  verifikasiProdiStart    DateTime
  verifikasiProdiEnd      DateTime
  
  keputusanAkademikStart  DateTime
  keputusanAkademikEnd    DateTime
  
  pengumumanDate          DateTime?
  
  keterangan              String?                @db.Text
  alasanPerpanjangan      String?                @db.Text

  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  pengajuan               PengajuanPengguguran[]

  @@map("periode_pengguguran")
}

model PengajuanPengguguran {
  id                    String              @id @default(cuid())
  nomorPengajuan        String              @unique // Contoh: "PG-20261-0001"
  periodeId             String
  periode               PeriodePengguguran  @relation(fields: [periodeId], references: [id])
  
  // Pengaju & Mahasiswa
  pengajuId             String?             // Opsional jika diajukan mandiri oleh mahasiswa
  pengaju               User?               @relation("PengajuUser", fields: [pengajuId], references: [id])
  nim                   String
  mahasiswa             Mahasiswa?          @relation(fields: [nim], references: [nim])
  namaMahasiswa         String
  
  // Program Studi
  prodiCode             String
  prodiName             String
  
  // Mata Kuliah
  mataKuliahId          String
  mataKuliah            MataKuliah          @relation(fields: [mataKuliahId], references: [id])
  kodeMatkul            String
  namaMatkul            String
  sks                   Int                 @default(3)
  kategoriMatkul        MataKuliahKategori  @default(NON_INTI)
  kurikulum             String?             @default("2024")
  
  // Alasan, Lampiran, & Status
  alasan                String              @db.Text
  lampiranUrl           String?
  lampiranNama          String?
  status                StatusPengguguran   @default(MENUNGGU_VERIFIKASI_PRODI)
  
  // Verifikasi Prodi
  verifikatorProdiId    String?
  verifikatorProdi      User?               @relation("VerifikatorProdi", fields: [verifikatorProdiId], references: [id])
  verifikatorProdiName  String?
  verifikasiProdiAt     DateTime?
  catatanProdi          String?             @db.Text
  
  // Keputusan Akademik
  keputusanAkademikId   String?
  keputusanAkademikUser User?               @relation("KeputusanAkademik", fields: [keputusanAkademikId], references: [id])
  keputusanAkademikName String?
  keputusanAkademikAt   DateTime?
  catatanAkademik       String?             @db.Text
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  riwayat               RiwayatPengguguran[]

  @@index([prodiCode])
  @@index([status])
  @@index([nim])
  @@index([periodeId])
  @@index([mataKuliahId])
  @@map("pengajuan_pengguguran")
}

model RiwayatPengguguran {
  id          String               @id @default(cuid())
  pengajuanId String
  pengajuan   PengajuanPengguguran @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  statusAwal  StatusPengguguran?
  statusAkhir StatusPengguguran
  actorId     String?
  actorName   String
  actorRole   String
  catatan     String?              @db.Text
  action      String               // SUBMIT, VERIFIKASI_PRODI_SETUJU, VERIFIKASI_PRODI_TOLAK, AKADEMIK_SETUJU, AKADEMIK_TOLAK, PERPANJANGAN_PERIODE
  createdAt   DateTime             @default(now())

  @@index([pengajuanId])
  @@map("riwayat_pengguguran")
}

